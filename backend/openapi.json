        "summary": "«Continuar con Google»: inicia sesión o crea la cuenta con un ID token de Google",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "401": {
            "description": "REFRESH_INVALID"
          }
        },
        "summary": "Renovar la sesión (el token de renovación usado deja de valer)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Cerrar sesión (revoca el token de renovación)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserView"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_UNAUTHORIZED"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/pets": {
      "get": {
        "operationId": "PetsController_list",
        "parameters": [
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "description": "Uno o varios, separados por comas: gato, perro, otros",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "ne",
            "required": false,
            "in": "query",
            "description": "true: solo mascotas con necesidades especiales",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "provincia",
            "required": false,
            "in": "query",
            "schema": {
              "example": "Barcelona",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetListView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Catálogo con filtros. Sin sesión o sin test: sin % y en el orden del catálogo.",
        "tags": [
          "pets"
        ]
      }
    },
    "/pets/{id}": {
      "get": {
        "operationId": "PetsController_detail",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetDetailView"
                }
              }
            }
          },
          "404": {
            "description": "PET_NOT_FOUND"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Ficha de la mascota",
        "tags": [
          "pets"
        ]
      }
    },
    "/test/questions": {
      "get": {
        "operationId": "TestController_questions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestView"
                }
              }
            }
          }
        },
        "summary": "Las 15 preguntas en 3 bloques, con sus opciones y consejos",
        "tags": [
          "test"
        ]
      }
    },
    "/test/answers": {
      "get": {
        "operationId": "TestController_answers",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswersView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Respuestas guardadas (null si aún no ha hecho el test)",
        "tags": [
          "test"
        ]
      },
      "put": {
        "operationId": "TestController_save",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswersDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswersView"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED · fields.qN [REQUIRED | INVALID_OPTION]"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Guardar o modificar las 15 respuestas (recalcula la compatibilidad)",
        "tags": [
          "test"
        ]
      }
    },
    "/compatibility": {
      "get": {
        "operationId": "CompatibilityController_list",
        "parameters": [
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "description": "Uno o varios, separados por comas: gato, perro, otros",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "ne",
            "required": false,
            "in": "query",
            "description": "true: solo mascotas con necesidades especiales",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "provincia",
            "required": false,
            "in": "query",
            "schema": {
              "example": "Barcelona",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompatibilityListView"
                }
              }
            }
          },
          "403": {
            "description": "TEST_REQUIRED"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Mascotas compatibles con la persona, de mayor a menor %. Admite los filtros del catálogo.",
        "tags": [
          "compatibility"
        ]
      }
    },
    "/requests": {
      "post": {
        "operationId": "AdoptionRequestsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestView"
                }
              }
            }
          },
          "403": {
            "description": "TEST_REQUIRED"
          },
          "404": {
            "description": "PET_NOT_FOUND"
          },
          "409": {
            "description": "ACTIVE_REQUEST_EXISTS (diálogo de Ficha-Limite) · PET_NOT_AVAILABLE"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Enviar una solicitud de adopción (exige el test hecho)",
        "tags": [
          "requests"
        ]
      }
    },
    "/requests/current": {
      "get": {
        "operationId": "AdoptionRequestsController_current",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentRequestView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Solicitud en proceso y la más reciente (para «Proceso» y el estado)",
        "tags": [
          "requests"
        ]
      }
    },
    "/requests/{id}/cancel": {
      "post": {
        "operationId": "AdoptionRequestsController_cancel",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestView"
                }
              }
            }
          },
          "404": {
            "description": "REQUEST_NOT_FOUND"
          },
          "409": {
            "description": "REQUEST_NOT_CANCELLABLE"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cancelar la solicitud en proceso (la mascota sigue disponible)",
        "tags": [
          "requests"
        ]
      }
    }
  },
  "info": {
    "title": "Pinky Pet API",
    "description": "API del proyecto académico Pinky Pet. Los errores siempre son { code, message, fields? }; la app traduce `code` a los textos del diseño. El % de compatibilidad es una simulación académica, no un instrumento validado.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "nombre@correo.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "contraseña-segura"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "hasTest": {
            "type": "boolean",
            "description": "true si ya ha respondido el test de compatibilidad"
          }
        },
        "required": [
          "id",
          "email",
          "hasTest"
        ]
      },
      "SessionView": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Segundos de vida del accessToken"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "persona@ejemplo.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "GoogleLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "ID token que devuelve el inicio de sesión de Google en la app"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "GoogleSessionView": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Segundos de vida del accessToken"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          },
          "created": {
            "type": "boolean",
            "description": "true si la cuenta se acaba de crear (desde Registro se va al Test)"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken",
          "user",
          "created"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Token de renovación recibido al iniciar sesión o en la última renovación"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "FotoView": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string",
            "example": "fotos/luna.jpg",
            "description": "Clave del asset empaquetado en la app"
          },
          "alt": {
            "type": "string"
          }
        },
        "required": [
          "asset",
          "alt"
        ]
      },
      "BlocksView": {
        "type": "object",
        "properties": {
          "hogar": {
            "type": "number"
          },
          "diaADia": {
            "type": "number"
          },
          "mascota": {
            "type": "number"
          }
        },
        "required": [
          "hogar",
          "diaADia",
          "mascota"
        ]
      },
      "CompatibilityView": {
        "type": "object",
        "properties": {
          "porcentaje": {
            "type": "number",
            "description": "Global, 0–100"
          },
          "bloques": {
            "$ref": "#/components/schemas/BlocksView"
          },
          "compatible": {
            "type": "boolean",
            "description": "porcentaje ≥ 50"
          }
        },
        "required": [
          "porcentaje",
          "bloques",
          "compatible"
        ]
      },
      "PetSummaryView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "luna"
          },
          "nombre": {
            "type": "string"
          },
          "especie": {
            "type": "string",
            "example": "Gata"
          },
          "sexo": {
            "type": "string"
          },
          "edad": {
            "type": "string"
          },
          "ciudad": {
            "type": "string"
          },
          "provincia": {
            "type": "string"
          },
          "tamano": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "gato",
              "perro",
              "otros"
            ]
          },
          "necesidadesEspeciales": {
            "type": "boolean"
          },
          "motivoCorto": {
            "type": "string",
            "example": "Encaja con tu rutina"
          },
          "foto": {
            "$ref": "#/components/schemas/FotoView"
          },
          "compatibilidad": {
            "description": "Solo con sesión y test hecho",
            "allOf": [
              {
                "$ref": "#/components/schemas/CompatibilityView"
              }
            ]
          }
        },
        "required": [
          "id",
          "nombre",
          "especie",
          "sexo",
          "edad",
          "ciudad",
          "provincia",
          "tamano",
          "tipo",
          "necesidadesEspeciales",
          "motivoCorto",
          "foto"
        ]
      },
      "PetListView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PetSummaryView"
            }
          },
          "total": {
            "type": "number",
            "description": "Número de resultados («6 mascotas»)"
          }
        },
        "required": [
          "items",
          "total"
        ]
      },
      "PetInfoView": {
        "type": "object",
        "properties": {
          "estadoSalud": {
            "type": "string"
          },
          "vacunacion": {
            "type": "string"
          },
          "cuidados": {
            "type": "string"
          },
          "comportamiento": {
            "type": "string"
          },
          "nivelActividad": {
            "type": "string"
          },
          "convivenciaMascotas": {
            "type": "string"
          },
          "necesidadesEspeciales": {
            "type": "string"
          },
          "historia": {
            "type": "string"
          }
        },
        "required": [
          "estadoSalud",
          "vacunacion",
          "cuidados",
          "comportamiento",
          "nivelActividad",
          "convivenciaMascotas",
          "necesidadesEspeciales",
          "historia"
        ]
      },
      "PetDetailView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "luna"
          },
          "nombre": {
            "type": "string"
          },
          "especie": {
            "type": "string",
            "example": "Gata"
          },
          "sexo": {
            "type": "string"
          },
          "edad": {
            "type": "string"
          },
          "ciudad": {
            "type": "string"
          },
          "provincia": {
            "type": "string"
          },
          "tamano": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "gato",
              "perro",
              "otros"
            ]
          },
          "necesidadesEspeciales": {
            "type": "boolean"
          },
          "motivoCorto": {
            "type": "string",
            "example": "Encaja con tu rutina"
          },
          "foto": {
            "$ref": "#/components/schemas/FotoView"
          },
          "compatibilidad": {
            "description": "Solo con sesión y test hecho",
            "allOf": [
              {
                "$ref": "#/components/schemas/CompatibilityView"
              }
            ]
          },
          "info": {
            "$ref": "#/components/schemas/PetInfoView"
          },
          "encaja": {
            "type": "string",
            "description": "«Lo que encaja contigo»"
          },
          "cuenta": {
            "type": "string",
            "description": "«Para que os vaya bien»"
          },
          "disponible": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "nombre",
          "especie",
          "sexo",
          "edad",
          "ciudad",
          "provincia",
          "tamano",
          "tipo",
          "necesidadesEspeciales",
          "motivoCorto",
          "foto",
          "info",
          "encaja",
          "cuenta",
          "disponible"
        ]
      },
      "BlockView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "hogar",
              "diaADia",
              "mascota"
            ]
          },
          "titulo": {
            "type": "string"
          },
          "peso": {
            "type": "number",
            "example": 0.34
          }
        },
        "required": [
          "id",
          "titulo",
          "peso"
        ]
      },
      "QuestionView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "q1"
          },
          "numero": {
            "type": "number"
          },
          "bloque": {
            "type": "string",
            "enum": [
              "hogar",
              "diaADia",
              "mascota"
            ]
          },
          "texto": {
            "type": "string"
          },
          "resumen": {
            "type": "string",
            "description": "Etiqueta corta de «Mi perfil»"
          },
          "opciones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consejo": {
            "type": "string",
            "description": "«Consejo del experto»"
          }
        },
        "required": [
          "id",
          "numero",
          "bloque",
          "texto",
          "resumen",
          "opciones"
        ]
      },
      "TestView": {
        "type": "object",
        "properties": {
          "bloques": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlockView"
            }
          },
          "preguntas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionView"
            }
          }
        },
        "required": [
          "bloques",
          "preguntas"
        ]
      },
      "AnswersView": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "answeredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "answers",
          "answeredAt"
        ]
      },
      "AnswersDto": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "object",
            "description": "Las 15 respuestas, con el texto literal de la opción elegida",
            "example": {
              "q1": "No",
              "q2": "No",
              "q3": "Vivo sola o solo"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "answers"
        ]
      },
      "CompatibilityListView": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Mascotas compatibles (≥ 50 %), de mayor a menor",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PetSummaryView"
            }
          },
          "sinCompatibles": {
            "type": "boolean",
            "description": "true → pantalla «Todavía no hay mascotas compatibles contigo»"
          },
          "umbral": {
            "type": "number",
            "example": 50
          }
        },
        "required": [
          "items",
          "sinCompatibles",
          "umbral"
        ]
      },
      "CreateRequestDto": {
        "type": "object",
        "properties": {
          "petId": {
            "type": "string",
            "example": "luna"
          },
          "replaceActive": {
            "type": "boolean",
            "description": "true = «Continuar y cancelar la anterior»: cancela la solicitud en proceso y envía esta",
            "default": false
          }
        },
        "required": [
          "petId"
        ]
      },
      "RequestView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "en_proceso",
              "finalizada",
              "rechazada",
              "cancelada"
            ]
          },
          "mascota": {
            "$ref": "#/components/schemas/PetSummaryView"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "estado",
          "mascota",
          "createdAt",
          "closedAt"
        ]
      },
      "CurrentRequestView": {
        "type": "object",
        "properties": {
          "activa": {
            "nullable": true,
            "description": "Solicitud en proceso, si la hay",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/RequestView"
              }
            ]
          },
          "ultima": {
            "nullable": true,
            "description": "La solicitud más reciente, en cualquier estado",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/RequestView"
              }
            ]
          }
        },
        "required": [
          "activa",
          "ultima"
        ]
      }
    }
  }
}
