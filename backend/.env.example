# Copia este archivo como .env y rellena los valores. .env no se sube nunca al repositorio.
NODE_ENV=development
PORT=3000
MONGODB_URI=
# Cadenas aleatorias de al menos 32 caracteres (por ejemplo: openssl rand -base64 48)
JWT_SECRET=
JWT_REFRESH_SECRET=
# Orígenes permitidos, separados por comas (servidor de desarrollo y Capacitor)
CORS_ORIGINS=http://localhost:8100,capacitor://localhost,https://localhost
# Contraseña de las cuentas demo que crea npm run seed
SEED_DEMO_PASSWORD=
# Solo desarrollo: clave para POST /dev/requests/:id/resolve (simular a la protectora)
DEV_KEY=
# «Continuar con Google»: IDs de cliente OAuth (web y Android) separados por comas. Vacío = desactivado. Ver docs/DEPLOY.md
GOOGLE_CLIENT_IDS=

# Recuperar contraseña (Brevo). Sin BREVO_API_KEY, el correo solo se escribe en el registro de la API.
BREVO_API_KEY=
# Remitente verificado en Brevo (obligatorio si hay BREVO_API_KEY)
MAIL_FROM=
# Dirección pública de la app (el enlace del correo apunta aquí)
APP_URL=http://localhost:8100
