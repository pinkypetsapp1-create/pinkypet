{
  "name": "pinky-pet-backend",
  "private": true,
  "description": "API de Pinky Pet (NestJS + MongoDB)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev:mem": "ts-node -r tsconfig-paths/register scripts/dev-mem.ts",
    "seed": "ts-node scripts/seed.ts",
    "openapi": "ts-node scripts/export-openapi.ts",
    "demo:resolve": "ts-node scripts/demo-resolve.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "jest --runInBand",
    "smoke": "ts-node scripts/smoke.ts",
    "mascota:leer": "ts-node scripts/mascota-nueva.ts",
    "mascotas:subir": "ts-node scripts/subir-mascotas.ts"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/src"
        ],
        "testRegex": "\\.spec\\.ts$"
      },
      {
        "displayName": "e2e",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/test"
        ],
        "testRegex": "\\.e2e-spec\\.ts$"
      }
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "11.3.4",
    "mongoose": "^8.24.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
